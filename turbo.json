{
	"$schema": "https://v2-9-16.turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"with": ["@better-agent/db#db:studio:local"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate:remote": {
			"cache": false
		},
		"db:push:remote": {
			"cache": false
		},
		"db:studio:local": {
			"cache": false,
			"persistent": true
		},
		"db:studio:remote": {
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"cache": false
		},
		"destroy": {
			"cache": false
		}
	}
}
