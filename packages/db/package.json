{
	"name": "@better-agent/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "DRIZZLE_D1_MODE=local drizzle-kit migrate",
		"db:migrate:remote": "DRIZZLE_D1_MODE=remote drizzle-kit migrate",
		"db:push": "bun run db:push:local",
		"db:push:local": "DRIZZLE_D1_MODE=local drizzle-kit push",
		"db:push:remote": "DRIZZLE_D1_MODE=remote drizzle-kit push",
		"db:studio:local": "DRIZZLE_D1_MODE=local drizzle-kit studio",
		"db:studio:remote": "DRIZZLE_D1_MODE=remote drizzle-kit studio"
	},
	"dependencies": {
		"@better-agent/env": "workspace:*",
		"@libsql/client": "0.17.3",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.1",
		"libsql": "0.5.29",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@better-agent/config": "workspace:*",
		"drizzle-kit": "^0.31.8",
		"typescript": "catalog:"
	}
}
