{
	"name": "better-agent",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/node": "^26.0.0",
			"@cloudflare/workers-types": "^4.20260623.1",
			"hono": "^4.12.27",
			"@orpc/server": "^1.14.6",
			"@orpc/openapi": "^1.14.6",
			"@orpc/zod": "^1.14.6",
			"better-auth": "1.6.20",
			"ai": "^6.0.208",
			"alchemy": "^0.93.12",
			"wrangler": "^4.103.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"@orpc/client": "^1.14.6",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:generate": "turbo -F @better-agent/db db:generate",
		"db:migrate:remote": "turbo -F @better-agent/db db:migrate:remote",
		"db:push:remote": "turbo -F @better-agent/db db:push:remote",
		"db:studio:local": "turbo -F @better-agent/db db:studio:local",
		"db:studio:remote": "turbo -F @better-agent/db db:studio:remote",
		"deploy": "turbo -F @better-agent/infra deploy",
		"destroy": "turbo -F @better-agent/infra destroy",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"dependencies": {
		"@better-agent/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@better-agent/config": "workspace:*",
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "0.56.0",
		"oxlint": "1.71.0",
		"turbo": "^2.9.18",
		"typescript": "catalog:",
		"ultracite": "7.8.3"
	},
	"packageManager": "bun@1.3.9"
}
