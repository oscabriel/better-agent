{
	"name": "better-agent",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/node": "^25.9.1",
			"@cloudflare/workers-types": "^4.20260528.1",
			"hono": "^4.8.2",
			"@orpc/server": "^1.14.4",
			"@orpc/openapi": "^1.14.4",
			"@orpc/zod": "^1.14.4",
			"better-auth": "1.6.11",
			"ai": "^6.0.192",
			"alchemy": "^0.93.9",
			"wrangler": "^4.77.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"@orpc/client": "^1.14.4",
			"@types/react": "^19.2.15",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @better-agent/db db:push",
		"db:generate": "turbo -F @better-agent/db db:generate",
		"deploy": "turbo -F @better-agent/infra deploy",
		"destroy": "turbo -F @better-agent/infra destroy",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"dependencies": {
		"@better-agent/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@better-agent/config": "workspace:*",
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "latest",
		"oxlint": "latest",
		"turbo": "^2.9.16",
		"typescript": "catalog:",
		"ultracite": "7.8.0"
	},
	"packageManager": "bun@1.3.9"
}
